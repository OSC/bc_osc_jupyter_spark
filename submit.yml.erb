<%-

  base_slurm_args = ["--nodes", "#{bc_num_slots}", "--exclusive" ]

  # Remove cluster tag, e.g. pitzer-gpu-exp to gpu-exp
  partition = global_node_type.split('-').drop(1).join('-')

  slurm_args = base_slurm_args + ["--partition", partition]

-%>
---
batch_connect:
  template: "basic"
  conn_params:
    - "tutorials_root"
    - "spark_master_webui_port"
    - "spark_master_host"
    - "spark_ui_auth_token"
    - "spark_version"
script:
  native:
  <%- slurm_args.each do |arg| %>
    - "<%= arg %>"
  <%- end %>
